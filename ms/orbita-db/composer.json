{
  "name": "orbita/db",
  "type": "project",
  "license": "proprietary",
  "description": "Standalone local ORBITA migration and disaster recovery runner",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "brick/math": "^0.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/recovery.php",
      "tests/mysql-grammar.php",
      "tests/import-mysql.php"
    ]
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/bin/phpunit --do-not-cache-result"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
