  "components": [
    {
      "name": "Основное действие витрины",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Красное действие отправки формы; не заменяет cyan-покупку.",
      "html": "<button type=\"button\" class=\"ds-primary\">Отправить менеджеру</button>",
      "css": ".ds-primary{font-family:\"Inter\",\"Arial\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;border-radius:7px;padding:.65rem 1rem;text-decoration:none;cursor:pointer;border:1px solid rgb(153 27 27);background:rgb(153 27 27);color:white}.ds-primary:hover:not(:disabled){background:rgb(127 29 29)}.ds-primary:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}.ds-primary:disabled{cursor:default;opacity:.65}"
    },
    {
      "name": "Вторичное действие",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Светлая ссылка с тонкой рамкой.",
      "html": "<a class=\"ds-secondary\" href=\"/shop/rubric/stroymaterialy\">Выбрать товары</a>",
      "css": ".ds-secondary{font-family:\"Inter\",\"Arial\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;border-radius:7px;padding:.65rem 1rem;text-decoration:none;cursor:pointer;background:rgb(248 250 252);color:rgb(22 78 99);border:1px solid rgb(203 213 225)}.ds-secondary:hover{background:rgb(236 254 255)}.ds-secondary:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}"
    },
    {
      "name": "Покупка товара",
      "kind": "button",
      "refersTo": "button-product",
      "description": "Обычная cyan-кнопка карточки товара.",
      "html": "<button type=\"button\" class=\"ds-product-add\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 3h2l2.5 12h10L21 6H6M9 20h.01M17 20h.01\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>В корзину</button>",
      "css": ".ds-product-add{font-family:\"Inter\",\"Arial\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;border-radius:7px;padding:.65rem 1rem;text-decoration:none;cursor:pointer;width:100%;background:rgb(14 116 144);border:1px solid rgb(14 116 144);color:white;font-size:.85rem;padding-inline:.5rem}.ds-product-add svg{width:22px;height:22px;flex:none}.ds-product-add:hover:not(:disabled){background:rgb(21 94 117)}.ds-product-add:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}.ds-product-add:disabled{cursor:default;opacity:.65}.ds-product-add.ds-in-cart{background:rgb(22 78 99);border-color:rgb(22 78 99)}"
    },
    {
      "name": "Покупка избранного товара",
      "kind": "button",
      "refersTo": "button-featured-product",
      "description": "Компактная мягкая кнопка исходной подборки.",
      "html": "<button type=\"button\" class=\"ds-featured-add\">В корзину</button>",
      "css": ".ds-featured-add{font-family:\"Inter\",\"Arial\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;border-radius:7px;padding:.65rem 1rem;text-decoration:none;cursor:pointer;min-width:108px;width:auto;padding:.5rem .8rem;border-radius:12px;font-size:.875rem;background:rgb(8 145 178);border:1px solid rgb(8 145 178);color:white}.ds-featured-add:hover:not(:disabled){background:rgb(21 94 117)}.ds-featured-add:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}.ds-featured-add:disabled{cursor:default;opacity:.65}.ds-featured-add.ds-in-cart{background:rgb(21 94 117);border-color:rgb(21 94 117)}"
    },
    {
      "name": "Поле ввода витрины",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Явная подпись и тонкая slate-рамка; образец email-поля footer.",
      "html": "<label class=\"ds-label\" for=\"ds-email\">Ваша почта</label><input class=\"ds-field\" id=\"ds-email\" type=\"email\" placeholder=\"Ваша почта\" autocomplete=\"email\"/>",
      "css": ".ds-label{font-family:\"Inter\",\"Arial\",sans-serif;display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;color:rgb(30 41 59)}.ds-field{font-family:\"Inter\",\"Arial\",sans-serif;width:100%;min-height:44px;padding:.65rem .8rem;color:rgb(30 41 59);background:white;border:1px solid rgb(148 163 184);border-radius:6px;caret-color:rgb(14 116 144)}.ds-field::placeholder{color:rgb(100 116 139)}.ds-field:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}"
    },
    {
      "name": "Desktop-категории",
      "kind": "nav",
      "description": "Горизонтальные ячейки исходного cyan-каталога; mobile раскрывается кнопкой.",
      "html": "<nav class=\"ds-catalog\" aria-label=\"Каталог\"><a href=\"/shop/rubric/stroymaterialy\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m8.25 4.5 7.5 7.5-7.5 7.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Материалы</a><a href=\"/shop/rubric/izolyatsiya\">Изоляция</a><a href=\"/shop/rubric/otdelka\">Отделка</a></nav>",
      "css": ".ds-catalog{font-family:\"Inter\",\"Arial\",sans-serif;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));box-shadow:0 8px 14px rgb(15 23 42 / .22)}.ds-catalog a{display:flex;gap:.2rem;align-items:center;justify-content:center;min-height:48px;padding:.65rem;background:linear-gradient(to right,rgb(6 182 212),rgb(103 232 249),rgb(6 182 212));border:1px solid rgb(209 213 219);font-size:1rem;font-weight:500;letter-spacing:.035em;color:rgb(17 24 39);text-decoration:none;text-align:center}.ds-catalog a:hover{background:linear-gradient(to right,rgb(103 232 249),rgb(165 243 252),rgb(103 232 249))}.ds-catalog a:focus-visible{outline:3px solid rgb(8 145 178);outline-offset:3px}.ds-catalog svg{width:16px;height:16px;margin-right:.45rem;color:rgb(127 29 29);flex:none}"
    },
    {
