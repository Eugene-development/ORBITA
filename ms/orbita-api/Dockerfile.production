FROM php:8.4-fpm-alpine AS base
RUN test "$(id -u www-data)" -eq 82
RUN apk add --no-cache icu-dev libzip-dev oniguruma-dev linux-headers curl fcgi \
  && docker-php-ext-install pdo_mysql bcmath mbstring intl zip pcntl opcache \
  && apk add --no-cache --virtual .redis-build $PHPIZE_DEPS \
  && pecl install redis && docker-php-ext-enable redis && apk del .redis-build
WORKDIR /var/www
RUN printf 'upload_max_filesize=10M\npost_max_size=12M\n' > /usr/local/etc/php/conf.d/orbita-upload.ini
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY entrypoint.sh /usr/local/bin/orbita-entrypoint
RUN chmod 755 /usr/local/bin/orbita-entrypoint
ENTRYPOINT ["/usr/local/bin/orbita-entrypoint"]
FROM base AS development
COPY . .
RUN composer install --prefer-dist --no-interaction --no-scripts --no-progress \
  && mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
  && php artisan package:discover --no-ansi \
  && chown -R www-data:www-data storage bootstrap/cache
USER www-data
CMD ["php-fpm", "-F"]
FROM base AS dependencies
COPY composer.json composer.lock ./
RUN composer install --no-dev --prefer-dist --no-interaction --no-scripts --no-progress
FROM base AS production
COPY . .
COPY --from=dependencies /var/www/vendor ./vendor
COPY cert/mysql-ca.pem /var/www/cert/mysql-ca.pem
RUN mkdir -p storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
  && php artisan package:discover --no-ansi \
  && php artisan lighthouse:cache --no-ansi \
  && chown -R www-data:www-data storage bootstrap/cache \
  && printf 'opcache.enable=1\nopcache.validate_timestamps=0\nexpose_php=Off\n' > /usr/local/etc/php/conf.d/orbita.ini
RUN printf '[www]\nclear_env = no\n' > /usr/local/etc/php-fpm.d/zz-runtime-env.conf

USER www-data
EXPOSE 9000
CMD ["php-fpm", "-F"]
