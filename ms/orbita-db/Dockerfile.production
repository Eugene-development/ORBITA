ARG ORBITA_API_IMAGE=larux/orbita-api:latest
FROM ${ORBITA_API_IMAGE}
COPY --chown=www-data:www-data database/migrations /migrations
COPY --chown=www-data:www-data database/recovery /recovery
COPY --chown=www-data:www-data database/recovery-manifest.json /recovery-manifest.json
CMD ["php", "artisan", "migrate", "--path=/migrations", "--realpath", "--force"]
