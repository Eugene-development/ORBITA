# Optional local development MySQL exposed by docker/local on loopback.
# Copy DB_DATABASE/DB_USERNAME/DB_PASSWORD from docker/local/.env; never use VPS credentials here.
APP_ENV=local
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=4153
DB_DATABASE=orbita_local
DB_USERNAME=orbita_local
DB_PASSWORD="REPLACE_LOCAL_PASSWORD"
MYSQL_ATTR_SSL_CA=
ORBITA_CATALOG_WRITES_ENABLED=false
